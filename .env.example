# Copy using: python scripts/init_local_env.py (generates local credentials).
# Empty credentials deliberately prevent Compose startup until configured.
POSTGRES_USER=medrag
POSTGRES_DB=medrag
POSTGRES_PASSWORD=
MINIO_ROOT_USER=medrag-local
MINIO_ROOT_PASSWORD=
POSTGRES_IMAGE=postgres:17.6-alpine
QDRANT_IMAGE=qdrant/qdrant:v1.15.4
REDIS_IMAGE=redis:7.4.5-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
MEDRAG_ENVIRONMENT=development
MEDRAG_DATABASE_URL=
MEDRAG_REDIS_URL=redis://127.0.0.1:6379/0
MEDRAG_QDRANT_URL=http://127.0.0.1:6333
MEDRAG_S3_ENDPOINT=http://127.0.0.1:9000
MEDRAG_S3_REGION=us-east-1
MEDRAG_S3_BUCKET=medical-rag-originals
MEDRAG_S3_ACCESS_KEY=
MEDRAG_S3_SECRET_KEY=
# Optional future model selection: no provider calls exist in M0.
# MEDRAG_GENERATOR__PROVIDER=openai
# MEDRAG_GENERATOR__MODEL_ID=<your-approved-model>
# MEDRAG_VERIFIER__PROVIDER=anthropic
# MEDRAG_VERIFIER__MODEL_ID=<your-approved-model>

# Local development bearer adapter; populate with scripts/init_dev_auth.py
MEDRAG_DEV_PRINCIPALS=[]
