# Copy using: python scripts/init_local_env.py (generates local credentials).
# Empty credentials deliberately prevent Compose startup until configured.
POSTGRES_USER=medrag
POSTGRES_DB=medrag
POSTGRES_PASSWORD=
MINIO_ROOT_USER=medrag-local
MINIO_ROOT_PASSWORD=
POSTGRES_IMAGE=postgres:17.6-alpine
QDRANT_IMAGE=qdrant/qdrant:v1.15.4
REDIS_IMAGE=redis:7.4.5-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
MEDRAG_ENVIRONMENT=development
MEDRAG_DATABASE_URL=
MEDRAG_REDIS_URL=redis://127.0.0.1:6379/0
MEDRAG_QDRANT_URL=http://127.0.0.1:6333
MEDRAG_S3_ENDPOINT=http://127.0.0.1:9000
MEDRAG_S3_REGION=us-east-1
MEDRAG_S3_BUCKET=medical-rag-originals
MEDRAG_S3_ACCESS_KEY=
MEDRAG_S3_SECRET_KEY=
# M7 grounded generation. Both are optional: with no generator configured the sufficiency gate
# still runs and the draft stage reports the provider as unconfigured, which is not a fallback to
# some default model. Keys are read backend-side only. Never create a VITE_-prefixed copy of one:
# anything VITE_ is compiled into the browser bundle and would publish the key.
# MEDRAG_GENERATOR__PROVIDER=openai
# MEDRAG_GENERATOR__MODEL_ID=<your-approved-model>
# MEDRAG_VERIFIER__PROVIDER=anthropic
# MEDRAG_VERIFIER__MODEL_ID=<your-approved-model>
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local development bearer adapter; populate with scripts/init_dev_auth.py
MEDRAG_DEV_PRINCIPALS=[]

# M6 restart-required runtime; policy changes are query-side, not reindexing.
MEDRAG_RERANKER__MODEL_CACHE_DIR=.local/models/reranking
MEDRAG_RERANKER__OFFLINE=true
MEDRAG_RERANKER__BATCH_SIZE=8
MEDRAG_RERANKER__TORCH_THREADS=4
# MEDRAG_RERANKER__ENDPOINT=http://retrieval:8010

# M10: operator-controlled approved provider/model pairs (JSON array).
# The configured generator and verifier pairs are also approved automatically.
# Never put credentials or arbitrary base URLs here. API container only.
MEDRAG_APPROVED_MODELS=[]

# ---------------------------------------------------------------- M12 production hardening
# Development keeps MEDRAG_ENVIRONMENT=development. Setting `production` makes Settings refuse to
# start unless every control below is satisfied; `scripts/production_preflight.py` reports which.
# MEDRAG_ENVIRONMENT=production

# Identity. Vendor-neutral: any OIDC-compliant issuer. Required in production.
# MEDRAG_AUTH__MODE=oidc
# MEDRAG_AUTH__ISSUER=https://login.example.com/v2.0
# MEDRAG_AUTH__AUDIENCE=api://medical-rag
# MEDRAG_AUTH__JWKS_URI=https://login.example.com/discovery/v2.0/keys
# MEDRAG_AUTH__ALGORITHMS=["RS256"]
# MEDRAG_AUTH__TENANT_CLAIM=tid
# MEDRAG_AUTH__ROLES_CLAIM=roles
# MEDRAG_AUTH__ROLE_MAPPING={"MedRag.Reader":"reader","MedRag.Curator":"curator","MedRag.Admin":"admin"}

# Abuse ceilings. Off by default so local work is unobstructed; required on in production.
# Per replica, not global — N replicas allow N times each budget.
# MEDRAG_LIMITS__RATE_LIMITING_ENABLED=true
# MEDRAG_LIMITS__ASK_PER_MINUTE=20
# MEDRAG_LIMITS__UPLOAD_PER_MINUTE=10
# MEDRAG_LIMITS__MAX_JSON_BODY_BYTES=262144
# Only where TLS termination is controlled: HSTS pins browsers to HTTPS the host must then serve.
# MEDRAG_LIMITS__HSTS_ENABLED=true

# Secrets may be mounted as files instead of set directly. Every managed secret store presents
# secrets this way, so this supports all of them and depends on none — and keeps the value out of
# the process environment, where /proc/<pid>/environ would expose it. A direct value wins.
# OPENAI_API_KEY_FILE=/var/run/secrets/medrag/openai-api-key
# MEDRAG_DATABASE_URL_FILE=/var/run/secrets/medrag/database-url

# Models must be offline-pinned in production so a deployment cannot silently fetch a different
# revision at query time. Compose already sets these for the services that load weights.
# MEDRAG_EMBEDDING__OFFLINE=true
# MEDRAG_QUERY_ENCODER__OFFLINE=true
